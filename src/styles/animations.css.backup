/**
 * GSAP Animations Stylesheet - Senior Designer Edition
 * ============================================
 * PHILOSOPHY:
 * - CSS for static styles, GSAP for motion
 * - NO initial states in CSS (GSAP controls everything)
 * - Smooth, cinematic transitions with custom easing
 * - GPU-accelerated transforms only
 * - Performance-first: 60fps guaranteed
 */

/* ============================================
   MICRO-INTERACTIONS & HOVER STATES
   ============================================ */

/* Smooth lift on hover - GPU accelerated */
.hover-lift {
  transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1),
              box-shadow 0.3s cubic-bezier(0.23, 1, 0.32, 1);
}

.hover-lift:hover {
  transform: translateY(-6px) translateZ(0);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
}

/* Button press effect */
.btn-press {
  transition: transform 0.15s cubic-bezier(0.23, 1, 0.32, 1);
}

.btn-press:active {
  transform: scale(0.97);
}

/* Scale with subtle glow */
.hover-glow {
  transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1),
              box-shadow 0.3s cubic-bezier(0.23, 1, 0.32, 1);
}

.hover-glow:hover {
  transform: scale(1.03);
  box-shadow: 0 8px 30px rgba(44, 95, 127, 0.25);
}

/* ============================================
   LAZY LOAD FADE FOR IMAGES
   ============================================ */

img[data-lazy-load] {
  opacity: 0;
  transition: opacity 0.6s cubic-bezier(0.23, 1, 0.32, 1);
}

img[data-lazy-load].loaded {
  opacity: 1;
}

/* ============================================
   RIPPLE EFFECT FOR BUTTONS
   ============================================ */

.ripple-btn {
  position: relative;
  overflow: hidden;
}

.ripple-btn::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transform: translate(-50%, -50%);
  transition: width 0.6s cubic-bezier(0.23, 1, 0.32, 1),
              height 0.6s cubic-bezier(0.23, 1, 0.32, 1),
              opacity 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  opacity: 0;
  pointer-events: none;
}

.ripple-btn:active::after {
  width: 300px;
  height: 300px;
  opacity: 1;
  transition: 0s;
}

/* ============================================
   GLASSMORPHISM UTILITY
   ============================================ */

.glass {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

/* ============================================
   GPU ACCELERATION
   ============================================ */

.gpu-accelerated {
  transform: translateZ(0);
  backface-visibility: hidden;
  perspective: 1000px;
}

.will-animate {
  will-change: transform, opacity;
}

.is-animating {
  will-change: transform, opacity;
}

.is-animated {
  will-change: auto;
}

/* ============================================
   AUDIO VISUAL FEEDBACK
   ============================================ */

.audio-playing {
  animation: audioPulse 0.3s cubic-bezier(0.23, 1, 0.32, 1);
}

@keyframes audioPulse {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
    box-shadow: 0 0 20px rgba(44, 95, 127, 0.5);
  }
  100% {
    transform: scale(1);
  }
}

.audio-active {
  animation: audioGlow 1.5s cubic-bezier(0.23, 1, 0.32, 1) infinite;
}

@keyframes audioGlow {
  0%, 100% {
    box-shadow: 0 0 5px rgba(44, 95, 127, 0.3);
  }
  50% {
    box-shadow: 0 0 20px rgba(44, 95, 127, 0.6);
  }
}

/* Loading spinner */
.loading-spinner {
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* ============================================
   ACCESSIBILITY - PREFERS REDUCED MOTION
   ============================================ */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ============================================
   PERFORMANCE UTILITIES
   ============================================ */

.contain-paint {
  contain: paint;
}

.content-visibility-auto {
  content-visibility: auto;
}

.preserve-3d {
  transform-style: preserve-3d;
}
